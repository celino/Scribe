<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the core assembly only (tests excluded). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,json</Format>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <Include>[Scribe.Core]Scribe.*</Include>
          <ExcludeByFile>**/tests/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
