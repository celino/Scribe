<?xml version="1.0" encoding="utf-8"?>
<!-- The core source file is compiled into the test assembly (until Scribe.Core becomes its own project), so the test
     assembly has to be instrumented, and only ScribeCore.cs counts. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,json</Format>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Include>[Scribe.Tests]Scribe.*</Include>
          <ExcludeByFile>**/tests/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
