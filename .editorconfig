root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Allman braces, as in the existing code
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
# C# 7.3 is the ceiling for the plugin (KSP 1.12 runs .NET Framework 4.8), so no newer syntax is suggested
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion

# Naming: public members PascalCase, private fields camelCase (the KSP code base does the same)
dotnet_naming_rule.public_members.severity = suggestion
dotnet_naming_rule.public_members.symbols = public_symbols
dotnet_naming_rule.public_members.style = pascal
dotnet_naming_symbols.public_symbols.applicable_kinds = property, method, field, event, class, struct, enum
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public
dotnet_naming_style.pascal.capitalization = pascal_case

# xUnit tests are named F01_what_it_proves
# CA5394: the property tests use a seeded Random on purpose (a failure must repeat); it is not used for security.
# CA1861 and CA1823 are about speed and leftovers in code that runs a few hundred times.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1823.severity = none

# Entry and SaveNode are plain data holders shared with the plugin; public fields keep them light and the code short
[Source/Core/*.cs]
dotnet_diagnostic.CA1051.severity = none
# Core is an internal library of one mod, not a public API: its callers are the plugin and the tests, which never pass null.
# Lists are exposed on purpose (the tests and the plugin read and fill them directly).
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1002.severity = none

# Plugin: the event handlers must not throw into the game, so the catch-all around each recording is deliberate (it logs).
# `Instance` and `Ledger` are public on purpose: the in-game test driver reads them. `Start` is a Unity message and cannot be static.
[Source/*.cs]
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA2211.severity = none
dotnet_diagnostic.CA1822.severity = none
